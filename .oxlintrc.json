{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "node"],
  "jsPlugins": ["./scripts/oxlint_plugin.js"],
  "categories": { "correctness": "error" },
  "ignorePatterns": ["test/benchmark/**"],
  "rules": {
    // Possible problems
    "array-callback-return": "warn",
    "no-constructor-return": "error",
    "no-promise-executor-return": "error",
    "no-self-compare": "error",
    "no-template-curly-in-string": "warn",
    "no-unmodified-loop-condition": "error",
    "no-unreachable": "warn",
    "no-unreachable-loop": "warn",
    "no-useless-assignment": "error",
    "no-useless-backreference": "warn",

    // Suggestions
    "accessor-pairs": "error",
    "block-scoped-var": "error",
    "complexity": ["warn", 50],
    "curly": ["warn", "multi-line"],
    "default-case-last": "error",
    "default-param-last": "error",
    "eqeqeq": ["error", "smart"],
    "grouped-accessor-pairs": "error",
    "no-array-constructor": "error",
    "no-case-declarations": "error",
    "no-div-regex": "error",
    "no-empty": "error",
    "no-eq-null": "error",
    "no-extend-native": "error",
    "no-extra-bind": "error",
    "no-extra-label": "error",
    "no-fallthrough": "error",
    "no-implied-eval": "error",
    "no-labels": "error",
    "no-label-var": "error",
    "no-lone-blocks": "error",
    "no-loop-func": "error",
    "no-multi-str": "error",
    "no-new": "error",
    "no-new-func": "error",
    "no-new-wrappers": "error",
    "no-regex-spaces": "error",
    "no-script-url": "error",
    "no-sequences": "error",
    "no-throw-literal": "error",
    "no-unexpected-multiline": "error",
    "no-unneeded-ternary": "error",
    "no-unused-vars": ["warn", {
      "vars": "all",
      "args": "none",
      "varsIgnorePattern": "^_",
      "caughtErrors": "none"
    }],
    "no-useless-call": "warn",
    "no-useless-computed-key": "warn",
    "no-useless-concat": "warn",
    "no-useless-escape": "off",
    "no-useless-rename": "warn",
    "no-var": "error",
    "no-void": "error",
    "no-warning-comments": "warn",
    "prefer-const": ["error", { "destructuring": "all" }],
    "prefer-rest-params": "error",
    "prefer-spread": "error",
    "preserve-caught-error": "error",
    "radix": "error",

    // TypeScript
    "typescript/adjacent-overload-signatures": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/ban-tslint-comment": "error",
    "typescript/consistent-generic-constructors": "error",
    "typescript/consistent-indexed-object-style": "error",
    "typescript/consistent-type-assertions": "error",
    "typescript/consistent-type-definitions": "error",
    "typescript/no-confusing-non-null-assertion": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-inferrable-types": ["warn", { "ignoreParameters": true }],
    "typescript/no-namespace": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-this-alias": "warn",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/prefer-for-of": "error",
    "typescript/prefer-function-type": "error",

    // Import
    "import/no-duplicates": "warn"
  },
  "overrides": [
    {
      "files": ["modules/**"],
      "env": { "browser": true },
      "globals": {
        "GeoJSON": "readonly"    // Global namespace from `@types/geojson` (UMD declaration)
      },
      "rules": {
        "no-console": "warn",
        "node/no-process-env": "error"
      }
    }, {
      // allow "useless assignment" when working with UI/D3 code - see 42eeb758
      "files": ["modules/ui/**"],
      "rules": {
        "no-useless-assignment": "off"
      }
    }, {
      "files": ["**/*.ts"],
      "rules": {
        "typescript/explicit-member-accessibility": ["error", { "accessibility": "explicit" }],
        "rapid/no-private-members": "error",
        "rapid/protected-underscore": "error"
      }
    }, {
      "files": ["scripts/**", "test/unit/**"],
      "globals": { "Bun": "readonly" }
    }, {
      "files": ["test/test_setup.js", "test/browser/**"],
      "env": { "browser": true, "mocha": true },   // describe, it, beforeEach, afterEach, etc.
      "globals": {
        "Rapid": "readonly",
        "d3": "readonly",
        "assert": "readonly",   // used by chai
        "fetchMock": "readonly"
      }
    }
  ]
}
