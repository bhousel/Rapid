          "content": {
            "size": -1,
            "mimeType": "application/json;charset=UTF-8",
            "text": "{\"url\":\"https://taginfo.openstreetmap.org/api/4/key/values?filter=ways&key=surface&lang=en&page=1&query=&rp=25&sortname=count_ways&sortorder=desc\",\"data_until\":\"2026-11-18T00:59:20Z\",\"page\":1,\"rp\":25,\"total\":8149,\"data\":[{\"value\":\"asphalt\",\"count\":38132904,\"fraction\":0.4639,\"in_wiki\":true,\"description\":\"Specifies that object is paved with asphalt concrete.\",\"desclang\":\"en\",\"descdir\":\"ltr\"},{\"value\":\"unpaved\",\"count\":13307608,\"fraction\":0.1619,\"in_wiki\":true,\"description\":\"Indicates that the feature has an unpaved surface, such as gravel or grass.\",\"desclang\":\"en\",\"descdir\":\"ltr\"},{\"value\":\"concrete\",\"count\":5732890,\"fraction\":0.0697,\"in_wiki\":true,\"description\":\"A surface of cement based concrete, cast in place.\",\"desclang\":\"en\",\"descdir\":\"ltr\"},{\"value\":\"paving_stones\",\"count\":5308941,\"fraction\":0.0646,\"in_wiki\":true,\"description\":\"A surface paved with artificial blocks (block pavers, bricks) or natural stones (flagstones), with a flat top.\",\"desclang\":\"en\",\"descdir\":\"ltr\"},{\"value\":\"paved\",\"count\":4532856,\"fraction\":0.0551,\"in_wiki\":true,\"description\":\"Describes the surface of a feature roughly as predominantly paved over the whole surface area; i.e., covered with paving stones, concrete, bitumen or asphalt. This value gives only a rough description; use a more precise value if possible.\",\"desclang\":\"en\",\"descdir\":\"ltr\"},{\"value\":\"ground\",\"count\":3880323,\"fraction\":0.0472,\"in_wiki\":true,\"description\":\"No special surface, the ground itself has marks of human or animal usage. This value gives only a rough description; if possible, use a more precise value such as grass, clay, laterite, sand, earth, gravel or pebblestone.\",\"desclang\":\"en\",\"descdir\":\"ltr\"},{\"value\":\"gravel\",\"count\":2471199,\"fraction\":0.0301,\"in_wiki\":true,\"description\":\"This tag has very large meaning range. Used for cases ranging from huge gravel pieces like track ballast used as surface, through small pieces of gravel to compacted surface.\",\"desclang\":\"en\",\"descdir\":\"ltr\"},{\"value\":\"dirt\",\"count\":2062274,\"fraction\":0.0251,\"in_wiki\":true,\"description\":\"Used for where surface is exposed earth/soil/dirt but it is not sand or gravel or rock.\",\"desclang\":\"en\",\"descdir\":\"ltr\"},{\"value\":\"grass\",\"count\":1643183,\"fraction\":0.02,\"in_wiki\":true,\"description\":\"Specifies that object has grass as a surface.\",\"desclang\":\"en\",\"descdir\":\"ltr\"},{\"value\":\"compacted\",\"count\":1557946,\"fraction\":0.019,\"in_wiki\":true,\"description\":null,\"desclang\":\"en\",\"descdir\":\"ltr\"},{\"value\":\"sand\",\"count\":693443,\"fraction\":0.0084,\"in_wiki\":true,\"description\":\"Specifies that object has sand as a surface.\",\"desclang\":\"en\",\"descdir\":\"ltr\"},{\"value\":\"sett\",\"count\":664038,\"fraction\":0.0081,\"in_wiki\":true,\"description\":\"Sett paving, formed from natural stones cut to have a flat top (with regular or irregular shape).\",\"desclang\":\"en\",\"descdir\":\"ltr\"},{\"value\":\"fine_gravel\",\"count\":590096,\"fraction\":0.0072,\"in_wiki\":true,\"description\":\"Loose, small gravel, not compacted, typically used on paths and driveways with minimal traffic.\",\"desclang\":\"en\",\"descdir\":\"ltr\"},{\"value\":\"wood\",\"count\":297266,\"fraction\":0.0036,\"in_wiki\":true,\"description\":\"Object with wooden surface. Used for bridges, plank walkways, and garden decking.\",\"desclang\":\"en\",\"descdir\":\"ltr\"},{\"value\":\"concrete:plates\",\"count\":233265,\"fraction\":0.0028,\"in_wiki\":true,\"description\":\"A surface made of heavy duty prefabricated concrete plates.\",\"desclang\":\"en\",\"descdir\":\"ltr\"},{\"value\":\"pebblestone\",\"count\":159149,\"fraction\":0.0019,\"in_wiki\":true,\"description\":null,\"desclang\":\"en\",\"descdir\":\"ltr\"},{\"value\":\"earth\",\"count\":156150,\"fraction\":0.0019,\"in_wiki\":true,\"description\":\"Used for where surface is exposed earth/soil/dirt but it is not sand or gravel or rock.\",\"desclang\":\"en\",\"descdir\":\"ltr\"},{\"value\":\"cobblestone\",\"count\":133474,\"fraction\":0.0016,\"in_wiki\":true,\"description\":\"Generic value for cobblestone, used for both sett and true cobblestone.\",\"desclang\":\"en\",\"descdir\":\"ltr\"},{\"value\":\"grass_paver\",\"count\":65188,\"fraction\":0.0008,\"in_wiki\":true,\"description\":\"Specifies that object is paved with grass paver – paving with large deliberate voids in it.\",\"desclang\":\"en\",\"descdir\":\"ltr\"},{\"value\":\"metal\",\"count\":60801,\"fraction\":0.0007,\"in_wiki\":true,\"description\":\"Used for metal-surfaced bridges, or for temporary tracks over fields for normal road vehicles or site traffic.\",\"desclang\":\"en\",\"descdir\":\"ltr\"},{\"value\":\"unhewn_cobblestone\",\"count\":60242,\"fraction\":0.0007,\"in_wiki\":true,\"description\":\"Raw cobblestone of natural, uncut, rounded stones.\",\"desclang\":\"en\",\"descdir\":\"ltr\"},{\"value\":\"artificial_turf\",\"count\":57807,\"fraction\":0.0007,\"in_wiki\":true,\"description\":\"A surface made from synthetic materials to look and feel like natural grass. Often used for tracks and pitches of sports such as football, baseball, etc.\",\"desclang\":\"en\",\"descdir\":\"ltr\"},{\"value\":\"clay\",\"count\":43975,\"fraction\":0.0005,\"in_wiki\":true,\"description\":\"A highway surface where clay is the dominant material and becomes soft when wet, or a tennis court surface made of crushed stone, brick, shale, or other unbound mineral aggregate.\",\"desclang\":\"en\",\"descdir\":\"ltr\"},{\"value\":\"tartan\",\"count\":43786,\"fraction\":0.0005,\"in_wiki\":true,\"description\":\"A synthetic, all-weather surface typically used in running.\",\"desclang\":\"en\",\"descdir\":\"ltr\"},{\"value\":\"concrete:lanes\",\"count\":38563,\"fraction\":0.0005,\"in_wiki\":true,\"description\":\"Narrow concrete elements placed in lanes for a two-tracked vehicle (motorcars) so that the tires always hit the concrete.\",\"desclang\":\"en\",\"descdir\":\"ltr\"}]}"
