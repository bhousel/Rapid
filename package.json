{
  "name": "@rapideditor/rapid",
  "version": "2.6.0",
  "description": "An AI-enhanced editor for OpenStreetMap",
  "repository": "github:facebook/Rapid",
  "homepage": "https://rapideditor.org",
  "bugs": "https://github.com/facebook/Rapid/issues",
  "keywords": [
    "editor",
    "openstreetmap"
  ],
  "license": "ISC",
  "type": "module",
  "main": "dist/rapid.min.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "all": "run-s clean build",
    "build": "run-s 'build:*'",
    "build:css": "bun ./scripts/build_css.js",
    "build:data": "bun ./scripts/build_data.js",
    "build:js": "bun ./scripts/build_js.ts",
    "build:svg": "run-p 'svg:*'",
    "clean": "bun ./scripts/clean.ts",
    "imagery": "bun ./scripts/imagery.js",
    "lint": "eslint ./modules ./test",
    "start": "run-s build start:server",
    "start:server": "bun ./scripts/server.ts",
    "stats": "run-s 'stats:**'",
    "stats:cloc:modules": "bunx cloc --skip-uniqueness --include-ext=css,js,ts,jsx,tsx  ./css ./data ./modules",
    "stats:cloc:tests": "bunx cloc --skip-uniqueness --include-ext=css,js,ts,jsx,tsx ./test",
    "svg:community": "svg-sprite --symbol --symbol-dest . --shape-id-generator \"community-%s\" --symbol-sprite dist/svg/community-sprite.svg node_modules/osm-community-index/dist/img/*.svg",
    "svg:fa": "svg-sprite --symbol --symbol-dest . --symbol-sprite dist/svg/fa-sprite.svg svg/fontawesome/*.svg",
    "svg:maki": "svg-sprite --symbol --symbol-dest . --shape-id-generator \"maki-%s\" --symbol-sprite dist/svg/maki-sprite.svg node_modules/@mapbox/maki/icons/*.svg",
    "svg:mapillary_signs": "svg-sprite --symbol --symbol-dest . --symbol-sprite dist/svg/mapillary-sprite.svg node_modules/@rapideditor/mapillary_sprite_source/package_signs/*.svg",
    "svg:mapillary_objects": "svg-sprite --symbol --symbol-dest . --symbol-sprite dist/svg/mapillary-object-sprite.svg node_modules/@rapideditor/mapillary_sprite_source/package_objects/*.svg",
    "svg:rapid": "svg-sprite --symbol --symbol-dest . --shape-id-generator \"rapid-%s\" --symbol-sprite dist/svg/rapid-sprite.svg \"svg/rapid-sprite/**/*.svg\"",
    "svg:roentgen": "svg-sprite --symbol --symbol-dest . --shape-id-generator \"roentgen-%s\" --symbol-sprite dist/svg/roentgen-sprite.svg svg/roentgen/*.svg",
    "svg:temaki": "svg-sprite --symbol --symbol-dest . --shape-id-generator \"temaki-%s\" --symbol-sprite dist/svg/temaki-sprite.svg node_modules/@rapideditor/temaki/icons/*.svg",
    "test": "run-s lint test:unit test:browser",
    "test:browser": "bun test --dots --preload ./test/test_setup.js ./test/browser/**/*.js",
    "test:unit": "bun test --dots --coverage ./test/unit",
    "translations": "bun ./scripts/tx_pull.js"
  },
  "dependencies": {
    "@mapbox/geojson-area": "^0.2.2",
    "@mapbox/geojson-rewind": "^0.5.2",
    "@mapbox/polylabel": "^1.0.2",
    "@mapbox/sexagesimal": "^1.2.0",
    "@mapbox/vector-tile": "^2.0.4",
    "@openstreetmap/id-tagging-schema": "^6.6.0",
    "@rapid-sdk/math": "~1.0.0-pre.4",
    "@rapid-sdk/util": "~1.0.0-pre.4",
    "@rapideditor/country-coder": "^5.6.0",
    "@rapideditor/location-conflation": "^1.7.0",
    "@tmcw/togeojson": "^7.1.2",
    "@xmldom/xmldom": "^0.8.11",
    "d3": "~7.9.0",
    "editor-layer-index": "github:osmlab/editor-layer-index#gh-pages",
    "fast-deep-equal": "^3.1.3",
    "fast-json-stable-stringify": "^2.1.0",
    "lodash-es": "^4.17.21",
    "mapillary-js": "^4.1.2",
    "maplibre-gl": "^3.6.2",
    "marked": "^16.4.1",
    "name-suggestion-index": "~7.0.20251101",
    "node-diff3": "^3.2.0",
    "osm-auth": "~3.1.1",
    "osm-community-index": "~6.0.0",
    "pannellum": "^2.5.6",
    "pbf": "^4.0.1",
    "pixi-filters": "^6.1.4",
    "pixi.js": "8.6.6",
    "pmtiles": "^4.3.0",
    "polyclip-ts": "^0.16.8",
    "prop-types": "^15.8.1",
    "rbush": "^4.0.1",
    "spectorjs": "^0.9.30",
    "tseep": "^1.3.1",
    "which-polygon": "^2.2.1",
    "wkt": "^0.1.1",
    "wmf-sitematrix": "^0.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@happy-dom/global-registrator": "^20.0.10",
    "@mapbox/maki": "^8.2.0",
    "@pixi/jsdoc-template": "^2.6.0",
    "@playwright/test": "^1.56.1",
    "@rapideditor/mapillary_sprite_source": "^1.8.0",
    "@rapideditor/temaki": "^5.11.0",
    "@transifex/api": "^7.1.4",
    "@types/bun": "^1.3.1",
    "@types/chai": "^5.2.3",
    "autoprefixer": "^10.4.21",
    "chai": "^6.2.0",
    "cldr-core": "^48.0.0",
    "cldr-localenames-full": "^48.0.0",
    "cloc": "^2.6.0-cloc",
    "eslint": "^9.39.1",
    "fetch-mock": "^12.6.0",
    "geojson-vt": "^4.0.2",
    "globals": "^16.5.0",
    "json-stringify-pretty-compact": "^4.0.0",
    "mocha": "^11.7.4",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.6",
    "postcss-selector-prepend": "^0.5.0",
    "sinon": "^21.0.0",
    "svg-sprite": "2.0.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vt-pbf": "^3.1.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "browserslist": [
    "> 1%, last 3 major versions, Firefox ESR, maintained node versions, not dead"
  ]
}
