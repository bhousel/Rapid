{
  "name": "@rapideditor/rapid",
  "version": "3.0.0-pre.1",
  "description": "An AI-enhanced editor for OpenStreetMap",
  "repository": "github:facebook/Rapid",
  "homepage": "https://rapideditor.org",
  "bugs": "https://github.com/facebook/Rapid/issues",
  "keywords": [
    "editor",
    "openstreetmap"
  ],
  "license": "ISC",
  "type": "module",
  "main": "dist/js/rapid-dev.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "all": "bun run --sequential clean check build",
    "build": "bun run --sequential 'build:*'",
    "build:css": "bun ./scripts/build_css.ts",
    "build:data": "bun ./scripts/build_data.ts",
    "build:js": "bun ./scripts/build_js.ts",
    "build:svg": "bun ./scripts/build_svg.ts",
    "check": "bun run --sequential 'check:*'",
    "check:csp": "bun ./scripts/check_csp.ts",
    "check:json": "bun ./scripts/validate_json.ts",
    "check:lint": "eslint ./modules ./test ./scripts",
    "check:ts": "tsc --noEmit",
    "clean": "bun ./scripts/clean.ts",
    "imagery": "bun ./scripts/build_imagery.ts",
    "start": "bun run --sequential build start:server",
    "start:server": "bun ./scripts/server.ts",
    "stats": "bun run --sequential 'build:js' 'stats:**'",
    "stats:bundle:dev": "esbuild-visualizer --metadata ./dist/js/rapid-dev.meta.json --filename ./docs/rapid-dev.html",
    "stats:bundle:prod": "esbuild-visualizer --metadata ./dist/js/rapid.meta.json --filename ./docs/rapid.html",
    "stats:cloc:modules": "bunx cloc --skip-uniqueness --include-ext=css,js,ts,jsx,tsx  ./css ./data ./modules",
    "stats:cloc:tests": "bunx cloc --skip-uniqueness --include-ext=css,js,ts,jsx,tsx ./test",
    "test": "bun run --sequential 'test:*'",
    "test:browser": "bun test --dots --preload ./test/test_setup.js ./test/browser/**/*.js",
    "test:unit": "bun test --dots --coverage ./test/unit",
    "translations": "node --experimental-strip-types ./scripts/tx_pull.ts",
    "translations_BUN": "bun ./scripts/tx_pull.ts"
  },
  "dependencies": {
    "@mapbox/geojson-area": "^0.2.2",
    "@mapbox/geojson-rewind": "^0.5.2",
    "@mapbox/polylabel": "^1.0.2",
    "@mapbox/sexagesimal": "^1.2.0",
    "@mapbox/vector-tile": "^3.0.0",
    "@openstreetmap/id-tagging-schema": "^6.16.0",
    "@rapid-sdk/math": "1.0.0-pre.5",
    "@rapid-sdk/util": "1.0.0-pre.5",
    "@rapideditor/country-coder": "^5.6.1",
    "@rapideditor/location-conflation": "^3.0.1",
    "@tmcw/togeojson": "^7.1.2",
    "@xmldom/xmldom": "^0.9.10",
    "d3": "~7.9.0",
    "diacritics": "^1.3.0",
    "editor-layer-index": "github:osmlab/editor-layer-index#gh-pages",
    "fast-deep-equal": "^3.1.3",
    "json5": "^2.2.3",
    "mapillary-js": "^4.1.2",
    "maplibre-gl": "^5.24.0",
    "marked": "^18.0.7",
    "minisearch": "^7.2.0",
    "name-suggestion-index": "~7.1.20260507",
    "node-diff3": "^3.2.1",
    "osm-auth": "~3.2.0",
    "osm-community-index": "~6.2.0",
    "pannellum": "^2.5.7",
    "pbf": "^5.1.2",
    "pixi-filters": "^6.1.5",
    "pixi.js": "8.19.0",
    "pmtiles": "^4.4.1",
    "polyclip-ts": "^0.16.8",
    "rbush": "^4.0.1",
    "spectorjs": "^0.9.30",
    "tseep": "^1.3.1",
    "which-polygon": "^2.2.1",
    "wkt": "^0.1.1",
    "wmf-sitematrix": "^0.2.0"
  },
  "devDependencies": {
    "@enzet/roentgen": "^0.16.0",
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@happy-dom/global-registrator": "^20.11.1",
    "@mapbox/maki": "^8.2.0",
    "@pixi/jsdoc-template": "^2.6.0",
    "@playwright/test": "^1.62.1",
    "@rapideditor/mapillary_sprite_source": "^1.8.0",
    "@rapideditor/temaki": "^5.13.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@transifex/api": "^7.1.6",
    "@types/bun": "^1.3.14",
    "@types/chai": "^5.2.3",
    "@types/d3": "^7.4.3",
    "@types/diacritics": "^1.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/svg-sprite": "^0.0.39",
    "@waysidemapping/pinhead": "^15.25.0",
    "autoprefixer": "^10.5.4",
    "chai": "^6.2.2",
    "cldr-core": "^48.2.0",
    "cldr-localenames-full": "^48.2.0",
    "cloc": "^2.6.0-cloc",
    "cssnano": "^8.0.2",
    "esbuild-visualizer": "^0.7.0",
    "eslint": "^10.8.0",
    "eslint-plugin-import": "^2.32.0",
    "fetch-mock": "^12.6.0",
    "geojson-vt": "^4.0.3",
    "globals": "^17.8.0",
    "json-stringify-pretty-compact": "^4.0.0",
    "jsonschema": "^1.5.0",
    "mocha": "^11.7.6",
    "postcss": "^8.5.25",
    "postcss-selector-prepend": "^0.5.0",
    "svg-sprite": "2.0.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vt-pbf": "^3.1.3"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "browserslist": [
    "> 1%, last 3 major versions, Firefox ESR, maintained node versions, not dead"
  ]
}
